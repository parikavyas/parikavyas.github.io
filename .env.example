# Copy to .env.local for local overrides. Set the same names in Vercel.
# Production URL (canonical links, sitemap, social previews)
NEXT_PUBLIC_SITE_URL=
# Optional: read-only token for public repos, avoids GitHub API rate limits (server-only)
GITHUB_TOKEN=
# Optional: how often synced README pages refresh, in seconds (default 86400)
README_REVALIDATE_SECONDS=86400
# Optional: show drafts (use only for Preview deployments)
SHOW_DRAFTS=false
